# ─── CLASP environment ───────────────────────────────────────────────
# Copy this file to .env.local and fill in. The app runs in SIMULATION
# mode until you flip the *_LIVE flags and provide keys.

# Flip to "true" to use the LIVE Clawpump API (server key below).
# The actual key stays server-side (never exposed to the browser).
NEXT_PUBLIC_CLAWPUMP_LIVE=false
CLAWPUMP_API_KEY=

# Meteora DBC (bond + earn) — set key + flip live when available
NEXT_PUBLIC_METEORA_LIVE=false
METEORA_API_KEY=
NEXT_PUBLIC_METEORA_API=https://api.meteora.ag

# Pyth (basis feed) — Hermes is publicly readable; key = higher limits
NEXT_PUBLIC_PYTH_LIVE=false
NEXT_PUBLIC_PYTH_KEY=

# Social back & copy backend (our own service; repoint as needed)
NEXT_PUBLIC_SOCIAL_LIVE=false
SOCIAL_API_KEY=
NEXT_PUBLIC_SOCIAL_API=https://api.clasp.xyz

# Solana RPC for mainnet reads (optional)
NEXT_PUBLIC_RPC=https://api.mainnet-beta.solana.com
